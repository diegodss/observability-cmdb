# Copy to .env and set JIRA_EMAIL and JIRA_API_TOKEN. Everything else is pre-filled for the
# shared dev Jira site. .env is gitignored: never commit real tokens.

# --- Fill these in --------------------------------------------------------------------------
# Your Atlassian account (needs read access to the Applications, Connectors and Integrations
# Assets schemas) and an API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Pre-filled for the dev site ------------------------------------------------------------
JIRA_SITE=https://nextbitfx-dev.atlassian.net
ASSETS_WORKSPACE_ID=4a24f736-5023-4aca-9267-da163a29121a

# API key callers send on /ci requests (Authorization: Bearer <key> or X-API-Key: <key>).
# This static value is for LOCAL DEVELOPMENT ONLY. In any shared or production environment,
# replace it with a secret (e.g. `openssl rand -hex 32`) and give it to Keep as a secret.
CMDB_API_KEY=local-dev-cmdb-key

# --- Defaults (rarely changed) ----------------------------------------------------------------
# Where lookups read from: "jira" (Jira Assets) or "mock" (the local data/*.csv files, no Jira).
CMDB_BACKEND=jira
# Host port of the API.
CMDB_HOST_PORT=8090
# Seconds to cache each CI's response (protects Jira's API from bursts); 0 disables.
CMDB_CACHE_SECONDS=60
# Optional override of the Assets REST base URL (tests and non-Cloud setups).
ASSETS_API_BASE=

# Setup/admin: the running service only needs READ access. `cmdb apply` needs Assets admin
# rights; pass an admin token for that one command (see README, "Setup and admin commands").
