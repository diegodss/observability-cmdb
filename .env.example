# Copy to .env and fill in. .env is gitignored: never commit real tokens.

# Where CI lookups read from: "jira" (Jira Assets) or "mock" (the local data/*.csv files).
CMDB_BACKEND=jira

# Jira Cloud site and a service account with Assets access.
# For the running service, use a READ-ONLY account. `apply` needs Assets admin rights: pass that
# token only for the apply command (see README, "Setup and admin commands").
# API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SITE=https://your-site.atlassian.net
JIRA_EMAIL=svc-observability@example.com
JIRA_API_TOKEN=

# Optional. Discovered from JIRA_SITE when empty.
ASSETS_WORKSPACE_ID=

# Optional override of the Assets REST base URL (tests and non-Cloud setups).
ASSETS_API_BASE=

# Host port of the API (docker compose up -d)
CMDB_HOST_PORT=8090

# API key callers must send on /ci requests (Authorization: Bearer <key> or X-API-Key: <key>).
# Leave empty only for local development. Generate one with: openssl rand -hex 32
CMDB_API_KEY=

# Seconds to cache each CI's response (protects Jira's API from bursts); 0 disables.
CMDB_CACHE_SECONDS=60
